{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/failure/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "components/surfaces/**",
              "tokens/**",
              "ui_kits/aixfreight-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Saira Condensed|IBM Plex Sans|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Saira Condensed, IBM Plex Sans, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Accordion'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|multiple|defaultOpen|style|key|ref|className|style|children)$/]",
        "message": "<Accordion> doesn't accept that prop. Declared props: items, multiple, defaultOpen, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AiDisclosureSource'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|time|href|key|ref|className|style|children)$/]",
        "message": "<AiDisclosureSource> doesn't accept that prop. Declared props: label, time, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='AiFallback'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|title|body|action|secondary|onAction|onSecondary|confidence|threshold|age|delta|rule|inverse|compact|style|key|ref|className|style|children)$/]",
        "message": "<AiFallback> doesn't accept that prop. Declared props: kind, title, body, action, secondary, onAction, onSecondary, confidence, threshold, age, delta, rule, inverse, compact, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AiFeedback'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|reasons|reason|onReason|label|thanks|inverse|size|style|key|ref|className|style|children)$/]",
        "message": "<AiFeedback> doesn't accept that prop. Declared props: value, onChange, reasons, reason, onReason, label, thanks, inverse, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AiFeedback'] > JSXAttribute[name.name='value'] > Literal[value!=/^(?:up|down)$/]",
        "message": "<AiFeedback> value must be one of 'up' | 'down'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AiFeedback'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<AiFeedback> size must be one of 'sm' | 'md'."
